# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → Connection details → enable "Connection pooling" → copy the string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the site (no trailing slash). On Vercel this can be omitted and
# Vercel's own URL variables are used, but set it once you have a custom domain.
# Production example: https://nexa-saver.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# ── Admin bootstrap ─────────────────────────────────────────────
# Preferred: set a strong password (min 8 chars). In production, admin is only
# seeded when this is set — there is no public default.
# ADMIN_INITIAL_PASSWORD=""

# ── PIN / security-answer pepper (server-only, never in the database) ──
# Generate with: openssl rand -base64 32
# With this set, a database leak alone cannot crack 4-digit PINs offline.
# NEXA_PIN_PEPPER=""

# ── PayChangu (https://developer.paychangu.com) ─────────────────
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""

# ── Kill switch (set to "true" to pause instantly) ──────────────
# NEXA_PAUSE_DEPOSITS="false"
# NEXA_PAUSE_WITHDRAWALS="false"
# NEXA_PAUSE_ALL="false"

# ── Cron (reconciliation) ───────────────────────────────────────
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when set in the project.
# CRON_SECRET=""

# ── Local development only ──────────────────────────────────────
# Lets you test deposits/withdrawals without PayChangu. Ignored in production builds.
NEXA_DEMO_PAYMENTS="true"

# Optional: absolute site URL for link-preview images (e.g. https://nexa-saver.vercel.app)
# VITE_SITE_URL=""

# ── Monitoring (optional) ───────────────────────────────────────
# SENTRY_DSN=""

# ── Email alerts (SMTP) ─────────────────────────────────────────
# Required for "new device / new network" login emails. Without these, alerts are skipped (logged only).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="NEXA-SAVER <noreply@yourdomain.com>"

# YouTube video id for pre-signup explainer (the ID after watch?v=)
# VITE_SIGNUP_INTRO_YOUTUBE_ID=

# YouTube video id for pre-signup explainer (ID after watch?v=)
# VITE_SIGNUP_INTRO_YOUTUBE_ID=
