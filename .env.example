# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → Connection details → enable "Connection pooling" → copy the string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the site (no trailing slash). On Vercel this can be omitted and
# Vercel's own URL variables are used, but set it once you have a custom domain.
BETTER_AUTH_URL="http://localhost:3000"

# ── PayChangu (https://developer.paychangu.com) ─────────────────
PAYCHANGU_SECRET_KEY=""
PAYCHANGU_WEBHOOK_SECRET=""

# ── Local development only ──────────────────────────────────────
# Lets you test deposits/withdrawals without PayChangu. Ignored in production builds.
NEXA_DEMO_PAYMENTS="true"

# Optional: absolute site URL for link-preview images (e.g. https://nexa-saver.vercel.app)
# VITE_SITE_URL=""
